# D2P Academy — ortam değişkenleri
# Kopyalayın: cp .env.example .env.local

# --- Zorunlu (tüm ortamlar) ---
NEXT_PUBLIC_SITE_URL=https://www.d2p.com.tr
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Zorunlu (production server) ---
# Öğrenci oturumu, auth rate limit, dinamik sitemap
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# En az 32 karakter; Supabase JWT secret ile aynı olmasın
STUDENT_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Kayıt onayı, eğitmen ve admin bildirim mailleri
RESEND_API_KEY=re_xxxxxxxx
# Resend'de doğrulanmış gönderici
RESEND_FROM_EMAIL="D2P Academy <info@d2p.com.tr>"
# Veli/çocuk kurs kaydı bildirimleri (virgülle birden fazla adres)
ADMIN_EMAIL=admin@d2p.com.tr

# --- Önerilen ---
# Supabase Edge Function webhook doğrulaması
# WEBHOOK_SECRET=your-long-random-secret
# Vercel'de sertifika PDF (chromium-min sürümüyle eşleşmeli)
# CHROMIUM_PACK_URL=https://github.com/Sparticuz/chromium/releases/download/v149.0.0/chromium-v149.0.0-pack.x64.tar

# --- Opsiyonel ---
# Yerel sertifika PDF (Chrome yolu)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- PayTR (ücretli etkinlik kart ödemeleri) ---
# Mağaza paneli > Destek ve Kurulum / Bilgi sayfasından Key ve Salt alınır.
# Bildirim URL: https://www.d2p.com.tr/api/v1/payments/paytr/callback
# PAYTR_MERCHANT_ID=
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=
# Testte 1 bırakın; canlıya geçince PAYTR_TEST_MODE=0
# PAYTR_TEST_MODE=1
# Taksit tablosu (PayTR panel > Taksit Tablosu hazır kodundaki token)
# PAYTR_INSTALLMENT_TABLE_TOKEN=
# İsterseniz sağlayıcıyı kilitleyin: PAYMENT_PROVIDER=paytr
# IYZICO_* yalnızca PayTR tanımlı değilse yedek olarak kullanılır.

# --- iyzico (yedek; PayTR tanımlıysa kullanılmaz) ---
# IYZICO_API_KEY=sandbox-xxx
# IYZICO_SECRET_KEY=sandbox-xxx
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Production doğrulama: npm run check:env
